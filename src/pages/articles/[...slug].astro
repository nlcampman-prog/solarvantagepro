---
const pinImages = import.meta.glob('../../public/pins/*.jpg', { eager: true });
import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths() {
  const articles = Object.values(import.meta.glob('../../content/articles/*.mdx', { eager: true }));
  return articles.map((article: any) => {
    const slug = (article.file?.split('/')?.pop()?.replace(/\.(mdx|md)$/, '')) || '';
    return { params: { slug }, props: { article } };
  });
}
const { article } = Astro.props;
const rawSlug = Astro.params.slug || '';
function getPinImage(slug) {
  const pinKeys = Object.keys(pinImages);
  for (const key of pinKeys) {
    const filename = key.split('/').pop();
    const name = filename.replace('.jpg', '');
    if (name.includes(slug) || slug.includes((name.split('-2026')[0] || ''))) {
      return 'https://solarvantagepro.com/pins/' + filename;
    }
  }
  return null;
}
const { title, description, pubDate, date, category, tags, metaDescription, featuredImage, author } = article.frontmatter || {};
const slug = (article.file?.split('/')?.pop()?.replace(/\.(mdx|md)$/, '')) || '';
const Content = article.Content;
---
<BaseLayout title={title} description={metaDescription || description} type="article" publishedTime image={getPinImage(rawSlug) || undefined}={date || pubDate} tags={tags}>
  <div class="container">
    <article>
      <span class="card-category">{category}</span>
      <h1>{title}</h1>
      <span>By <a href="/authors/nichole/" style="font-weight:600;">{(author || 'Nichole')}</a></span><span aria-hidden="true"> · </span><div class="card-meta" style="margin-bottom:2rem;">{new Date(date || pubDate || Date.now()).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</div>
      <Content />
    </article>
  </div>
</BaseLayout>